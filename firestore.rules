rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validCashPayment() {
      return request.resource.data.fulfillmentMethod == 'delivery'
        && request.resource.data.paymentMethod == 'cash_on_delivery'
        && request.resource.data.paymentStatus == 'pending';
    }

    function validStripePayment() {
      let paymentId = request.resource.data.paymentIntentId;
      let paymentPath = /databases/$(database)/documents/stripePayments/$(paymentId);
      return request.resource.data.paymentMethod == 'card_payment'
        && request.resource.data.paymentStatus == 'paid'
        && paymentId is string
        && request.resource.data.paymentAmountCents is int
        && request.resource.data.paymentAmountCents
          == request.resource.data.total * 100
        && exists(paymentPath)
        && get(paymentPath).data.customerId == request.auth.uid
        && get(paymentPath).data.status == 'succeeded'
        && get(paymentPath).data.currency == 'usd'
        && get(paymentPath).data.amountCents
          == request.resource.data.paymentAmountCents
        && get(paymentPath).data.fulfillmentMethod
          == request.resource.data.fulfillmentMethod;
    }

    match /users/{userId} {
      allow create, read, update: if ownsDocument(userId);
      allow delete: if false;
    }

    match /stripePayments/{paymentId} {
      // Created only by the Admin SDK after Stripe confirms payment.
      allow read, write: if false;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'placed'
        && (validCashPayment() || validStripePayment())
        && request.resource.data.orderNumber is string
        && request.resource.data.customerEmail is string
        && request.resource.data.receiverName is string
        && request.resource.data.phone is string
        && request.resource.data.deliveryAddress is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.subtotal >= 5
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.serviceFee >= 0
        && request.resource.data.discount >= 0
        && request.resource.data.etaMinMinutes == 30
        && request.resource.data.etaMaxMinutes == 40
        && request.resource.data.total
          == request.resource.data.subtotal
            + request.resource.data.deliveryFee
            + request.resource.data.serviceFee
            - request.resource.data.discount;

      allow read: if signedIn()
        && resource.data.customerId == request.auth.uid;

      // Staff/admin updates will be added later using secure custom claims.
      allow update, delete: if false;
    }
  }
}